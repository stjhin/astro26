---
import Skills from "@/components/Skills.astro";

export interface Props {
  /** Semantic heading level for the "About me" heading (default 2) */
  headingLevel?: 1 | 2;
}

const { headingLevel = 2 } = Astro.props;
const skillsLevel = (headingLevel + 1) as 2 | 3;

const withBase = (path: string) => {
  const base = import.meta.env.BASE_URL.endsWith("/")
    ? import.meta.env.BASE_URL
    : `${import.meta.env.BASE_URL}/`;
  return `${base}${path.replace(/^\/+/, "")}`;
};
---

<section id="About" class="container mx-auto mb-28 p-6">
  {
    headingLevel === 1 ? (
      <h1 class="heading text-3xl md:text-5xl uppercase mb-8">About me</h1>
    ) : (
      <h2 class="heading text-3xl md:text-5xl uppercase mb-8">About me</h2>
    )
  }
  <div class="grid grid-cols-1 md:grid-cols-2 items-center md:p-0 gap-8">
    <div class="space-y-6">
      <div
        class="w-full aspect-[668/516] md:max-w-[668px] overflow-hidden rounded-3xl"
      >
        <img
          src={withBase("/thesis.png")}
          alt="Thesis Image"
          class="w-full h-full object-cover cursor-pointer"
          data-modalable
        />
      </div>
    </div>

    <div>
      <div class="text-lg md:text-xl text-secondary space-y-4">
        <p>
          I was trained as an architect before becoming a product designer, and
          I still approach design the same way today. Whether I'm designing a
          product, a workflow, or an AI interaction pattern, I start by
          understanding how the whole system works before designing individual
          pieces.
        </p>

        <p>
          I believe good design happens where business goals, user needs, and
          engineering constraints meet. The best products aren't just intuitive
          to use. They're practical to build, accessible by default, and
          designed to evolve without losing quality.
        </p>

        <p>
          I enjoy solving problems that span multiple disciplines because that's
          where the most meaningful design decisions happen. Whether I'm
          designing user flows, reusable systems, or AI interactions, I'm
          interested in the relationships between things as much as the things
          themselves. Good design isn't just about creating interfaces; it's
          about creating structures that help people understand complexity and
          help teams build better products together.
        </p>

        <p>
          <i>
            The image on the left is from my master's thesis in architecture.
            Although I design software today, the way I think hasn't changed.
            The medium has changed from buildings to digital products, but the
            mindset is the same.
          </i>
        </p>
      </div>
    </div>
  </div>

  <Skills headingLevel={skillsLevel} />
</section>
