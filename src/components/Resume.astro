---
import Position from "@/components/Position.astro";
import Skills from "@/components/Skills.astro";

const withBase = (path: string) => {
  const base = import.meta.env.BASE_URL.endsWith("/")
    ? import.meta.env.BASE_URL
    : `${import.meta.env.BASE_URL}/`;
  return `${base}${path.replace(/^\/+/, "")}`;
};
---

<section class="resume container mx-auto pt-18 p-6">
  <div
    class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8"
  >
    <h1 class="heading text-5xl md:text-9xl uppercase">Resume</h1>
    <a
      href={withBase("/Resume-Ju2026.pdf")}
      download
      class="w-full sm:w-auto flex items-center justify-center bg-primary rounded-2xl py-3 px-6 sm:py-4 sm:px-10 cursor-pointer hover:bg-background hover:outline hover:outline-1 hover:outline-dashed hover:outline-secondary hover:text-foreground transition text-background font-mono font-bold"
    >
      Download Resume
    </a>
  </div>

  <div class="summary max-w-3xl mb-10">
    <p class="text-lg md:text-xl text-secondary leading-relaxed">
      A systems thinker who bridges business goals, user needs, and engineering
      constraints to design products that are intuitive, scalable, and practical
      to build. I combine <strong
        >User Research, Systems Thinking, and Cross-Functional Collaboration</strong
      > to solve complex problems, helping teams deliver high-quality experiences
      faster while improving consistency, accessibility, and long-term maintainability.
    </p>
  </div>

  <div class="positions space-y-2">
    <Position
      company="Intelex"
      title="Product Designer"
      description="Designed enterprise software from discovery through delivery, improving complex workflows through systems thinking and close collaboration with engineering."
      date="2022–2026"
    >
      <ul
        class="description text-tertiary text-xs md:text-sm list-disc pl-5 space-y-1"
      >
        <li>
          Redesigned core compliance workflows through user research and
          information architecture, reducing task completion time by 50% and
          support tickets by 40%..
        </li>
        <li>
          Built and maintained the shared design system that supported the
          integration of the acquired ACTS product into the Intelex ecosystem.
        </li>
        <li>
          Built Intelex's first cross-platform design system, scaling across 40+
          applications, 100+ product surfaces, and 100+ engineers.
        </li>
        <li>
          Reduced component creation time by 80% through an AI-assisted
          Figma-to-Storybook pipeline.
        </li>
        <li>
          Achieved 80% adoption across 10+ product teams, reducing developer
          handoff questions by 70%.
        </li>
      </ul>
    </Position>
    <Position
      company="Acid Integrations"
      title="UX Designer — Consultancy"
      description="0-to-1 product launch for early-stage startups."
      date="2018–2022"
    >
      <ul
        class="description text-tertiary text-xs md:text-sm list-disc pl-5 space-y-1"
      >
        <li>
          Designed and launched 0-to-1 digital products for early-stage
          startups.
        </li>
        <li>
          Reduced iteration cycles by 50% with lightweight research and
          experimentation frameworks
        </li>
      </ul>
    </Position>
  </div>
  <hr class="my-16 border-secondary/30" />

  <Skills headingLevel={2} />
</section>
